# Local development defaults are safe: read production data, do not write, do not call API-Football.
THECORNERFC_MODE=local
THECORNERFC_READ_ONLY=true
THECORNERFC_NO_API=true

# Prefer a Supabase/Postgres role with SELECT-only permissions for local development.
READ_ONLY_DATABASE_URL=postgresql://readonly_user:readonly_password@db.example.supabase.co:5432/postgres

# Production/write credentials are for GitHub Actions or an intentional local override only.
DATABASE_URL=
API_FOOTBALL_KEY=
API_DAILY_RESERVE=200

# Leave unset unless you intentionally want local writes/API calls.
# To override locally you must also set THECORNERFC_READ_ONLY=false and/or THECORNERFC_NO_API=false.
THECORNERFC_LOCAL_OVERRIDE=
